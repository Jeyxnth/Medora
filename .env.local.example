NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# AI providers, tried in this order. Gemini (every key x every model), then Groq chat as the last route for text calls only.
LLM_PROVIDERS=gemini,groq
# Image calls: gemini only (Groq is never used for images)
LLM_VISION_PROVIDERS=gemini
GEMINI_API_KEY=
# Optional extra Gemini keys, used automatically when the first one hits its quota
GEMINI_API_KEY_2=
# Or a comma-separated list instead: GEMINI_API_KEYS=
# Optional Gemini model overrides. List what your keys can use with: npm run check:gemini-models
GEMINI_MODEL=
GEMINI_VISION_MODEL=
GEMINI_FALLBACK_MODELS=
# Failover timing (defaults are in lib/config.ts): retry delay, retries per route, rest after a failed route, per-call timeout, total budget
LLM_RETRY_DELAY_MS=
LLM_RETRY_ATTEMPTS=
LLM_ROUTE_COOLDOWN_MS=
LLM_CALL_TIMEOUT_MS=
LLM_TOTAL_BUDGET_MS=
GROQ_API_KEY=
# Optional, defaults are in lib/config.ts. List valid ids with: npm run check:models
GROQ_CHAT_MODEL=
GROQ_WHISPER_MODEL=
